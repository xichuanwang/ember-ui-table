<div class="ui-table__actions">
  <div class="ui-table__actions-select">
    <CheckBox @isIndeterminate={{@isIndeterminate}} @selectedItems={{@selectedItems}} @onCheckboxChange={{@onCheckboxChange}}/>
  </div>
  {{#if (gt @selectedItems.size 0)}}
    <div class="ui-table__actions-download">Download selected</div>
  {{/if}}
</div>