<tbody class="ui-table__body">
  {{#if @data.isPending}}
    {{#each this.ghostRows as |row|}}
      <GhostRow 
        @columns={{@columns}}
      />
    {{/each}}
  {{else if @data.isResolved}}
    {{#each this.processedRows as |rowData idx|}}
      <Row 
        @validationFunction={{@validationFunction}}
        @selectedItems={{@selectedItems}} 
        @rowData={{rowData}} 
        @onClick={{@handleRowClick}} 
        @idx={{idx}}
      />
    {{/each}}
  {{/if}}
</tbody>