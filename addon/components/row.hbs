<tr class="ui-table__row" tabindex=0 aria-selected="{{this.isSelected}}" {{on "click" this.onRowClick}}>
  <td class="ui-table__cell-checkbox">
    <input type="checkbox" checked={{this.isSelected}} disabled={{not this.canRowBeSelected}} {{on "click" this.onCheckboxClick}}/>
  </td>

  {{#each @rowData as |rowData|}}
    <td class="ui-table__cell">
      {{#if rowData.customCellComponent}}
        {{component rowData.customCellComponent data=rowData.data}}
      {{else}}
        {{rowData.data}}        
      {{/if}}
    </td>
  {{/each}}
</tr>