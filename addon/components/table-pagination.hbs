<nav>
  <button
    type="button"
    disabled={{this.isFirstPage}}
    {{on "click" (fn this.onPageChange -1)}}
  >
    Previous
  </button>

  <span>
    Page {{@pagination.currentPage}} of {{@pagination.totalPages}}
  </span>

  <button
    type="button"
    disabled={{this.isLastPage}}
    {{on "click" (fn this.onPageChange 1)}}
  >
    Next
  </button>
</nav>