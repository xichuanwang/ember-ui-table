<div ...attributes class="ui-table-wrapper" role="region" aria-labelledby="table-caption">
  {{#if this.data.isPending}}
    <div class="loading-indicator">Loading...</div>
  {{else if this.data.isRejected}}
    <div class="error-indicator">Error loading data</div>
  {{else if this.data.isResolved}}
    <table class="ui-table" aria-multiselectable="true">
      <caption id="table-caption">{{@title}}</caption>
      
      <thead class="ui-table__header">
        <tr class="ui-table__header-actions">
          <td><input type="checkbox" /></td>
          <td class="ui-table__header-actions-download">Download selected</td>
        </tr>
        <tr class="ui-table__header-labels">
          <th scope="col"></th>
          {{#each this.columns as |column|}}
            <th scope="col">{{column.displayName}}</th>
          {{/each}}
        </tr>
      </thead>

      <TableBody @columns={{this.columns}} @data={{this.data.value}} />

      <tfoot class="ui-table__footer">
        <tr>
          <!-- pagiation here -->
        </tr>
      </tfoot>
    </table>
  {{/if}}
</div>