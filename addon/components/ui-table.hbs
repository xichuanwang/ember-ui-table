<div ...attributes class="ui-table-wrapper" role="region" aria-labelledby="table-caption">
  <TableActions 
    @selectedItems={{this.selectedItems}} 
    @onCheckboxChange={{this.onCheckboxChange}}
    @isIndeterminate={{this.isIndeterminate}}
    @onDownload={{this.onDownload}}
  />

  <table class="ui-table" aria-multiselectable="true">
    <caption id="table-caption" class="visually-hidden">{{@title}}</caption>
    
    <TableHeader @columns={{this.columns}} />
    
    <TableBody
      @validationFunction={{@validationFunction}}
      @columns={{this.columns}} 
      @data={{this.data}}
      @selectedItems={{this.selectedItems}}
      @handleRowClick={{this.handleRowClick}}
      @pageSize={{@pagination.pageSize}}
    />

    {{#if @pagination}}
      <tfoot class="ui-table__footer">
        <tr>
          <td colspan={{this.args.columns.length}}>
            <TablePagination
              @pagination={{@pagination}}
              @onPageChange={{this.onPageChange}}
            />
          </td>
        </tr>
      </tfoot>
    {{/if}}
  </table>
</div>